# Copy to `.env` and fill in real credentials. `.env` is gitignored.

# Required competition credentials
EM_API_KEY=YOUR_COMPETITION_API_KEY
EM_WEBHOOK_SECRET=YOUR_WEBHOOK_SIGNING_SECRET

# Live news fallback
ALPHAVANTAGE_API_KEY=
# NEWS_API_KEY=

# Historical/retraining providers
TINGO_API=
# TIINGO_API_KEY=
TWELVE_DATA_API_KEY=
FMP_API_KEY=
FINNHUB_API_KEY=
# FINNHUBB_API=

# Optional structured reasoning. Live use remains OFF unless explicitly enabled.
OPEN_ROUTER_API_KEY=
OPEN_ROUTER_MODEL=openrouter/free
OPEN_ROUTER_MAX_CALLS=25
OPEN_ROUTER_DATA_COLLECTION=deny
# V3_LIVE_USE_OPENROUTER=0

# Production model selection
# PRODUCTION_MODEL=v3_lite_candidate
# EXPECTED_V3_LITE_MODEL=v3_lite_operator_2026_08_19

# Modal maps these to its persistent /v3-data volume.
# V3_HISTORY_CACHE_PATH=data/company_history/company_history.sqlite
# V3_EVIDENCE_DIR=data/evidence

# Competition API override; normally leave commented.
# EM_API_BASE_URL=https://api.explainingmarkets.ai/v1
