# Copy this file to `.env` and fill it in:  cp .env.example .env
# Modal loads `.env` at deploy time, so `modal deploy` picks these up.
# `.env` is gitignored — never commit your real credentials.

# ── Required ── paste these two from your submission's Credentials tab ──
EM_API_KEY=YOUR_COMPETITION_API_KEY
EM_WEBHOOK_SECRET=YOUR_WEBHOOK_SIGNING_SECRET

# ── V3 historical/free-provider stack ──
# Tiingo Starter EOD adjusted-price history. The project accepts the user's
# existing TINGO_API spelling and the canonical TIINGO_API_KEY alias.
TINGO_API=
# TIINGO_API_KEY=

# Finnhub Free: last four EPS-surprise quarters + one year of company news.
FINNHUB_API_KEY=
# Backwards-compatible alias accepted by the code:
# FINNHUBB_API=

# OpenRouter structured reasoning. For zero-cost smoke tests use
# OPEN_ROUTER_MODEL=openrouter/free. Historical enrichment stays deterministic
# unless --reasoning-mode=openrouter is explicitly supplied.
OPEN_ROUTER_API_KEY=
OPEN_ROUTER_MODEL=openrouter/free
OPEN_ROUTER_MAX_CALLS=25
OPEN_ROUTER_DATA_COLLECTION=deny

# ── Optional Alpha Vantage fallback/live news ──
# Alpha Vantage remains useful for live NEWS_SENTIMENT and cached historical
# fallback data. Historical enrichment defaults to zero new Alpha calls.
ALPHAVANTAGE_API_KEY=
# NEWS_API_KEY=

# Local overrides. Modal sets these to its persistent /v3-data volume.
# V3_HISTORY_CACHE_PATH=data/company_history/company_history.sqlite
# V3_EVIDENCE_DIR=data/evidence

# EM_API_BASE_URL=https://api.explainingmarkets.ai/v1
