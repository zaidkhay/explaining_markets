# Copy this file to `.env` and fill it in:  cp .env.example .env
# Modal loads `.env` at deploy time, so `modal deploy` picks these up.
# `.env` is gitignored — never commit your real credentials.

# ── Required ── paste these two from your submission's Credentials tab ──
EM_API_KEY=YOUR_COMPETITION_API_KEY
EM_WEBHOOK_SECRET=YOUR_WEBHOOK_SIGNING_SECRET

# ── Optional V3 news + structured reasoning ──
# Alpha Vantage NEWS_SENTIMENT provider. NEWS_API_KEY is accepted as a
# backwards-compatible alias, but ALPHAVANTAGE_API_KEY is preferred.
ALPHAVANTAGE_API_KEY=
# NEWS_API_KEY=

# Optional OpenAI structured reasoner. Without this key the system uses the
# deterministic bounded reasoner, so tests/provider failures remain reproducible.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini

# Local overrides. Modal sets these to its persistent /v3-data volume.
# V3_HISTORY_CACHE_PATH=data/company_history/company_history.sqlite
# V3_EVIDENCE_DIR=data/evidence

# MARKET_DATA_API_KEY=
# EM_API_BASE_URL=https://api.explainingmarkets.ai/v1
