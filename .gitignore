# Secrets — never commit
.env
.env.example

# Local-only dev/maintenance scripts
scripts/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual envs / tooling
.venv/
venv/
.uv/
